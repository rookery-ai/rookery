#!/bin/sh
# commit-msg — rejects credentials, warns on local-environment leakage, and
# rejects non-conventional messages.
#
# Pure grep -E with NO external dependency, deliberately. gitleaks is not
# installed on most machines, and a hook that shells out to a missing binary
# silently succeeds — the same failure CLAUDE.md records for the gitleaks
# [[allowlists]] syntax: a check that loads, does nothing, and reports success.
#
# GitHub's push protection scans file CONTENT only. It never reads a commit
# message. This hook and its pr.yml counterpart cover what GitHub does not.
#
# Two severities, not one (see .githooks/README.md for the full rationale):
#   patterns-block.txt — credential shapes. BLOCKING (exit 1). A leaked
#     credential is a security incident: it is permanent, public, and the
#     secret must be rotated, not merely edited out.
#   patterns-warn.txt  — local-environment shapes (home paths, .lan hosts,
#     RFC1918/CGNAT addresses). ADVISORY ONLY (prints, exits 0). This repo's
#     own commit history routinely and legitimately describes self-hosted
#     testing against RFC1918 addresses and .lan hosts, and CI debugging
#     against /home/runner paths — blocking those messages trains people to
#     disable the hook, which then protects nothing.
#
# Install with: make hooks
set -eu

msg_file="$1"
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
block_patterns="$hook_dir/patterns-block.txt"
warn_patterns="$hook_dir/patterns-warn.txt"

# Comment lines are stripped by git after this hook runs, so strip them here too
# or a scissors-line diff would be scanned as though it were the message.
body=$(grep -v '^#' "$msg_file" || true)

# A merge or revert commit is generated by git; do not lint its shape.
case "$body" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

if [ -f "$block_patterns" ]; then
  if printf '%s\n' "$body" | grep -nEf "$block_patterns"; then
    echo >&2
    echo "commit-msg: the lines above look like a credential." >&2
    echo "Commit messages are permanently public and GitHub's push protection never reads them." >&2
    echo "Rewrite the message, and if this is a real credential, ROTATE it — removing it from the message does not." >&2
    exit 1
  fi
fi

if [ -f "$warn_patterns" ]; then
  warn_hits=$(printf '%s\n' "$body" | grep -nEf "$warn_patterns" || true)
  if [ -n "$warn_hits" ]; then
    echo >&2
    echo "commit-msg: advisory — the lines below look like a local-environment path or internal address:" >&2
    printf '%s\n' "$warn_hits" >&2
    echo "This is not blocking. Review before pushing; it is fine if the message is genuinely about this repo's own self-hosted/local-environment behavior." >&2
    echo >&2
  fi
fi

subject=$(printf '%s\n' "$body" | sed '/^[[:space:]]*$/d' | head -n 1)
if ! printf '%s' "$subject" | grep -qE '^(feat|fix|refactor|docs|test|chore|perf|build|ci)(\([a-z0-9/_-]+\))?!?: .+'; then
  echo "commit-msg: not a Conventional Commit:" >&2
  echo "  $subject" >&2
  echo >&2
  echo "Expected: type(scope): summary" >&2
  echo "Types: feat fix refactor docs test chore perf build ci" >&2
  exit 1
fi
